rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // 관리자: 모든 사용자의 내담자·기록을 "읽기만" 가능. AI 이용 키(private)는 볼 수 없음.
    // app.js의 ADMINS 목록과 같게 유지
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['leejjinhong@gmail.com'];
    }
    // 의견 보내기: 로그인한 사용자는 자기 이름으로 새 의견만 쓸 수 있고, 읽기·상태 변경은 관리자만
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
      match /clients/{id} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /records/{id} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
      match /private/{id} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
